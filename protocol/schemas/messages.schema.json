{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qp-relay:1:messages",
  "title": "Relay messages 1",
  "$defs": {
    "audience_hello": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.audience"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "hello"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": ["protocol", "version", "type", "token"],
      "additionalProperties": false
    },
    "audience_welcome": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.audience"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "welcome"
        },
        "connection_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\uD800-\\uDFFF]*$"
          },
          "uniqueItems": true
        },
        "available": {
          "type": "boolean"
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_message_bytes": {
              "const": 4096
            },
            "request_cache_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "required": ["max_message_bytes", "request_cache_ms"],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol",
        "version",
        "type",
        "connection_id",
        "capabilities",
        "available",
        "limits"
      ],
      "additionalProperties": false
    },
    "reaction": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.audience"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "reaction"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "kind": {
          "enum": ["thumbs_up", "heart", "applause", "laugh", "question"]
        }
      },
      "required": ["protocol", "version", "type", "request_id", "kind"],
      "additionalProperties": false
    },
    "comment": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.audience"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "comment"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "handle": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": ["protocol", "version", "type", "request_id", "body", "handle"],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.audience"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "result"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "status": {
          "enum": [
            "accepted",
            "busy",
            "stopped",
            "unavailable",
            "unknown",
            "expired",
            "denied",
            "policy_unavailable"
          ]
        }
      },
      "required": ["protocol", "version", "type", "request_id", "status"],
      "additionalProperties": false
    },
    "audience_state": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.audience"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "state"
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": ["protocol", "version", "type", "revision", "available"],
      "additionalProperties": false
    },
    "presenter_hello": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.presenter"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "hello"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": ["protocol", "version", "type", "token"],
      "additionalProperties": false
    },
    "presenter_welcome": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.presenter"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "presenter_welcome"
        },
        "presenter_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "display_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "audience_connections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "protocol",
        "version",
        "type",
        "presenter_epoch",
        "display_epoch",
        "audience_connections"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.presenter"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "event"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "connection_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "presenter_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "display_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "offer_ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "reaction"
                },
                "kind": {
                  "enum": ["thumbs_up", "heart", "applause", "laugh", "question"]
                }
              },
              "required": ["type", "kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "comment"
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "handle": {
                  "type": "string",
                  "maxLength": 32
                }
              },
              "required": ["type", "body", "handle"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "protocol",
        "version",
        "type",
        "event_id",
        "connection_id",
        "request_id",
        "presenter_epoch",
        "display_epoch",
        "offer_ttl_ms",
        "payload"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.presenter"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "receipt"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "presenter_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "status": {
          "enum": ["accepted", "busy", "stopped"]
        }
      },
      "required": ["protocol", "version", "type", "event_id", "presenter_epoch", "status"],
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.presenter"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "display"
        },
        "presenter_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "display_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "paused": {
          "type": "boolean"
        }
      },
      "required": ["protocol", "version", "type", "presenter_epoch", "display_epoch", "paused"],
      "additionalProperties": false
    },
    "presenter_state": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "qp.presenter"
        },
        "version": {
          "const": "1"
        },
        "type": {
          "const": "state"
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "display_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "available": {
          "type": "boolean"
        },
        "audience_connections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "protocol",
        "version",
        "type",
        "revision",
        "display_epoch",
        "available",
        "audience_connections"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/audience_hello"
    },
    {
      "$ref": "#/$defs/audience_welcome"
    },
    {
      "$ref": "#/$defs/reaction"
    },
    {
      "$ref": "#/$defs/comment"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/audience_state"
    },
    {
      "$ref": "#/$defs/presenter_hello"
    },
    {
      "$ref": "#/$defs/presenter_welcome"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/display"
    },
    {
      "$ref": "#/$defs/presenter_state"
    }
  ]
}
