{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qp-relay:1:end-response",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "state": {
      "enum": ["Ended", "Expired"]
    }
  },
  "required": ["room_id", "state"],
  "additionalProperties": false
}
