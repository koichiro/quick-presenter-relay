{
  "name": "quick-presenter-relay",
  "version": "1.0.2",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test:coverage": "npm run build && c8 node --test tests/*.test.mjs",
    "test:capacity": "npm run build && node --test tests/manual/capacity-pressure.mjs",
    "test:pressure": "npm run build && node --test --test-concurrency=1 tests/manual/socket-pressure.mjs tests/manual/fixture-pressure.mjs",
    "ci": "npm run check && npm run typecheck && npm run test:coverage",
    "fixture": "npm run build && node scripts/run-relay-fixture.mjs",
    "build": "npm run build --workspace quick-presenter-relay-core && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('protocol','dist/protocol',{recursive:true})\"",
    "typecheck": "npm run typecheck --workspace quick-presenter-relay-core && npm run build --workspace quick-presenter-relay-core && tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/cli.js",
    "pack:core": "npm pack --workspace quick-presenter-relay-core",
    "pack:web": "npm pack --workspace quick-presenter-audience-web",
    "prepack": "npm run build",
    "pack:server": "npm pack --workspaces=false"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "c8": "12.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ws": "8.23.0",
    "quick-presenter-relay-core": "1.0.2",
    "quick-presenter-audience-web": "1.0.2"
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    }
  },
  "workspaces": [
    "packages/room-core",
    "packages/audience-web"
  ],
  "description": "Self-hosted Node.js relay server for Quick Presenter Audience Live.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koichiro/quick-presenter-relay.git"
  },
  "homepage": "https://github.com/koichiro/quick-presenter-relay#readme",
  "bugs": {
    "url": "https://github.com/koichiro/quick-presenter-relay/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "quick-presenter-relay": "dist/src/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "dist/scripts/contracts.*",
    "dist/protocol",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md"
  ]
}
